# ============================================================
#  SADVN - Root .gitignore
#  Bao phủ toàn bộ project: Frontend (Next.js) + Backend (Spring Boot)
# ============================================================

# ===================== ENVIRONMENT & SECRETS =====================
# File .env chứa thông tin nhạy cảm (DB credentials, JWT secret, API keys...)
# CHỈ commit file .env.example làm template
.env
.env.local
.env.production
.env.staging
.env.prod
.env.development
!.env.example

# ===================== FRONTEND (Next.js / Node.js) =====================
# Dependencies
**/node_modules/

# Next.js build output
**/.next/
**/out/

# Production build
**/build/
!**/src/main/**/build/
!**/src/test/**/build/

# Package manager
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp
.pnp.*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
**/coverage/

# Vercel
.vercel

# ===================== BACKEND (Java / Spring Boot / Gradle) =====================
# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# Build output
**/build/
!**/src/main/**/build/
!**/src/test/**/build/

# ===================== IDE & EDITOR =====================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# ===================== OS FILES =====================
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ===================== LOGS =====================
**/logs/
*.log

# ===================== CERTIFICATES & KEYS =====================
*.pem
*.key
*.p12
*.jks

# ===================== RELEASE / BUILD ARTIFACTS =====================
# Thư mục release chứa bản build production để deploy trực tiếp lên server qua git
!release/backend/backend.jar
!release/frontend/.next/
!release/frontend/.next/**
release/frontend/node_modules/


# ===================== MISC =====================
*.swp
*.swo
*~
.agents/
