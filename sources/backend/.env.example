# ===== SERVER =====
APP_NAME=Backend sadvn.vn
SERVER_PORT=8386
SPRING_PROFILES_ACTIVE=dev

# ===== DATABASE =====
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_HOST=your_database_host
DATABASE_PORT=1433
DATABASE_ENCRYPT=false

# ===== HIKARI CONNECTION POOL =====
DATABASE_MAXPOOL=20
DATABASE_MINPOOL=10
DATABASE_TIMEOUT=30000
DATABASE_MAXLIFETIME=1800000
DATABASE_IDLETIMEOUT=600000
DATABASE_LEAKDETECTION=60000

# ===== JWT =====
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=860000
JWT_ISSUER=sadvn.vn

# ===== CORS =====
CORS_ALLOWED_ORIGINS=https://sadvn.vn,https://www.sadvn.vn